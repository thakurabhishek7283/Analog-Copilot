# The one ngspice pin (LLD §2: same version for the WASM build and the sim_runner image).
# Sourced by fetch.sh / build-native.sh / build-wasm.sh. Hashes checked against the
# SourceForge md5/sha1 listing when the pin was taken.
NGSPICE_VERSION=47
NGSPICE_BASE_URL=https://downloads.sourceforge.net/project/ngspice/ng-spice-rework/47
NGSPICE_SRC=ngspice-47.tar.gz
NGSPICE_SRC_SHA256=894e649651f1838a14095e5a5439e7d3aa63e87ede14d283173fda4fcdef675f
# Official Windows build of the same release: local development on Windows only.
NGSPICE_WIN64=ngspice-47_64.7z
NGSPICE_WIN64_SHA256=59225971bd68cdd1199443649aa4615a9e6d684933f205ab49006a3942518f5a
# Emscripten toolchain image used by build-wasm.sh (locally and in CI).
EMSDK_IMAGE=emscripten/emsdk:6.0.10
