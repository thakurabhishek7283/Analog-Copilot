{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "$ref": "#/$defs/ApplyOk"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "err": {
          "$ref": "#/$defs/OpError"
        }
      },
      "required": [
        "err"
      ],
      "additionalProperties": false
    }
  ],
  "title": "Outcome",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApplyOk": {
      "type": "object",
      "properties": {
        "rev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "patch": {
          "$ref": "#/$defs/Patch"
        },
        "inverse": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Op"
          },
          "description": "Ops that undo this change, in the order they must be applied."
        }
      },
      "required": [
        "rev",
        "patch",
        "inverse"
      ],
      "description": "What a successful `apply` reports to the UI: only what changed (LLD §10)."
    },
    "Patch": {
      "type": "object",
      "properties": {
        "parts_upserted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parts_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nets_upserted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nets_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks_upserted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analyses_changed": {
          "type": "boolean"
        },
        "hints_changed": {
          "type": "boolean"
        },
        "library_changed": {
          "type": "boolean",
          "default": false
        },
        "tests_changed": {
          "type": "boolean",
          "default": false
        },
        "requirements_changed": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "parts_upserted",
        "parts_removed",
        "nets_upserted",
        "nets_removed",
        "blocks_upserted",
        "blocks_removed",
        "analyses_changed",
        "hints_changed"
      ],
      "description": "What changed, by id, so the UI never needs the whole circuit per op (LLD §10)."
    },
    "Op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.begin"
            },
            "body": {
              "$ref": "#/$defs/BlockBegin"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.commit"
            },
            "body": {
              "$ref": "#/$defs/BlockRef"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.abort"
            },
            "body": {
              "$ref": "#/$defs/BlockAbort"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.remove"
            },
            "body": {
              "$ref": "#/$defs/BlockRef"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Inverse of `block.begin`."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.set_status"
            },
            "body": {
              "$ref": "#/$defs/BlockSetStatus"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Inverse of `block.commit` / `block.abort`."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "part.add"
            },
            "body": {
              "$ref": "#/$defs/PartAdd"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "part.remove"
            },
            "body": {
              "$ref": "#/$defs/PartRef"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "part.set_param"
            },
            "body": {
              "$ref": "#/$defs/PartSetParam"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "part.swap"
            },
            "body": {
              "$ref": "#/$defs/PartSwap"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "part.pin"
            },
            "body": {
              "$ref": "#/$defs/PartPin"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "net.connect"
            },
            "body": {
              "$ref": "#/$defs/NetConnect"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "net.disconnect"
            },
            "body": {
              "$ref": "#/$defs/NetDisconnect"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "net.rename"
            },
            "body": {
              "$ref": "#/$defs/NetRename"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "analysis.set"
            },
            "body": {
              "$ref": "#/$defs/AnalysisSet"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "hint.add"
            },
            "body": {
              "$ref": "#/$defs/HintBody"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "hint.remove"
            },
            "body": {
              "$ref": "#/$defs/HintBody"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Inverse of `hint.add`."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "narrate"
            },
            "body": {
              "$ref": "#/$defs/Narrate"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "lib.add"
            },
            "body": {
              "$ref": "#/$defs/LibAdd"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Add a component definition to the project library (LLD §17 D13)."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "lib.update"
            },
            "body": {
              "$ref": "#/$defs/LibUpdate"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Replace a definition; its instances and the definitions that use it are checked again."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "lib.remove"
            },
            "body": {
              "$ref": "#/$defs/LibRemove"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Remove a definition nothing uses. Inverse of `lib.add`."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "instance.expand"
            },
            "body": {
              "$ref": "#/$defs/InstanceExpand"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Replace an instance of a library component by its parts, as a block."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "block.set_spec"
            },
            "body": {
              "$ref": "#/$defs/BlockSetSpec"
            }
          },
          "required": [
            "op",
            "body"
          ],
          "description": "Replace a block's spec targets (a deliberate retune)."
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "test.set"
            },
            "body": {
              "$ref": "#/$defs/TestSet"
            }
          },
          "required": [
            "op",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "req.set"
            },
            "body": {
              "$ref": "#/$defs/ReqSet"
            }
          },
          "required": [
            "op",
            "body"
          ]
        }
      ]
    },
    "BlockBegin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/BlockRole"
        },
        "title": {
          "type": "string"
        },
        "spec": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecTarget"
          },
          "default": {}
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BlockPort"
          },
          "default": []
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "role",
        "title"
      ]
    },
    "BlockRole": {
      "type": "string",
      "enum": [
        "supply",
        "source",
        "bias",
        "amplifier",
        "buffer",
        "filter",
        "oscillator",
        "comparator",
        "load",
        "other"
      ]
    },
    "SpecTarget": {
      "type": "object",
      "properties": {
        "target": {
          "type": "number",
          "format": "double"
        },
        "tol_pct": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "target",
        "tol_pct"
      ]
    },
    "BlockPort": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/PortDirection"
        },
        "net": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction",
        "net"
      ],
      "description": "A named interface of a block, bound to the net that carries it (checked by ERC009)."
    },
    "PortDirection": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "bidir",
        "power_pos",
        "power_neg",
        "ground"
      ]
    },
    "BlockRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "BlockAbort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ]
    },
    "BlockSetStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BlockStatus"
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "BlockStatus": {
      "type": "string",
      "enum": [
        "planned",
        "composing",
        "verified",
        "committed",
        "failed"
      ]
    },
    "PartAdd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Values as written (\"10k\", \"4.7u\"); unspecified params take the registry default.",
          "default": {}
        },
        "block": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ],
          "description": "Normally derived from the envelope; set explicitly by inverse ops so undo restores it."
        }
      },
      "required": [
        "refdes",
        "part"
      ]
    },
    "Origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "llm"
            }
          },
          "required": [
            "kind",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "template"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "PartRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        }
      },
      "required": [
        "refdes"
      ]
    },
    "PartSetParam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "refdes",
        "key",
        "value"
      ]
    },
    "PartSwap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        },
        "part": {
          "type": "string"
        }
      },
      "required": [
        "refdes",
        "part"
      ]
    },
    "PartPin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "refdes"
      ]
    },
    "Placement": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "rot": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Degrees: 0, 90, 180 or 270.",
          "default": 0
        },
        "flip": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "NetConnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinRef"
          }
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Applied when the net is created; must match if the net exists."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "net",
        "pins"
      ]
    },
    "PinRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$",
      "description": "Part pin as REFDES.PIN, e.g. \"R3.1\" or \"U1.OUT_A\"."
    },
    "NetKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "signal"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "volts": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "power"
            }
          },
          "required": [
            "kind",
            "volts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ground"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "NetDisconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinRef"
          }
        }
      },
      "required": [
        "net",
        "pins"
      ]
    },
    "NetRename": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "AnalysisSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analyses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Analysis"
          }
        }
      },
      "required": [
        "analyses"
      ]
    },
    "Analysis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "op"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "start": {
              "type": "number",
              "format": "double"
            },
            "stop": {
              "type": "number",
              "format": "double"
            },
            "step": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "dc"
            }
          },
          "required": [
            "type",
            "source",
            "start",
            "stop",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "points_per_decade": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "f_start": {
              "type": "number",
              "format": "double"
            },
            "f_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ac"
            }
          },
          "required": [
            "type",
            "points_per_decade",
            "f_start",
            "f_stop"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t_step": {
              "type": "number",
              "format": "double"
            },
            "t_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "tran"
            }
          },
          "required": [
            "type",
            "t_step",
            "t_stop"
          ]
        }
      ]
    },
    "HintBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hint": {
          "$ref": "#/$defs/LayoutHint"
        }
      },
      "required": [
        "hint"
      ]
    },
    "LayoutHint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dir": {
              "$ref": "#/$defs/Direction"
            },
            "kind": {
              "type": "string",
              "const": "flow"
            }
          },
          "required": [
            "kind",
            "dir"
          ]
        },
        {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            },
            "b": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "near"
            }
          },
          "required": [
            "kind",
            "a",
            "b"
          ]
        },
        {
          "type": "object",
          "properties": {
            "block": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "kind",
            "block"
          ]
        }
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "right",
        "down"
      ]
    },
    "Narrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "block": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "refs",
        "text"
      ]
    },
    "LibAdd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "def": {
          "$ref": "#/$defs/ComponentDef",
          "description": "Boxed: a definition is large next to every other op body."
        }
      },
      "required": [
        "def"
      ]
    },
    "ComponentDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part": {
          "$ref": "#/$defs/PartDef",
          "description": "The component as a part: id (`lib:<name>`), category `X`, title, refdes `prefix`, pins,\nlimits and symbol (`auto`, a box the editor draws from the pins, or a registry symbol whose\nanchors match the pins). It has no `spice` line and, for now, no params."
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "part",
        "version",
        "model",
        "provenance"
      ]
    },
    "PartDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "description": "Refdes prefix when it is not the category letter (`RV`, `TP`); see [`EXTRA_PREFIXES`]."
        },
        "title": {
          "type": "string"
        },
        "role_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units of a multi-unit IC (e.g. `[A, B]` for a dual op-amp). Empty for single-unit parts.",
          "default": []
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinDef"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParamDef"
          },
          "description": "Every param must declare a default, so instances always carry a full param set.",
          "default": {}
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "description": "Ratings used by ERC, e.g. `v_supply_max`, `i_max`, `p_max`.",
          "default": {}
        },
        "dc_param": {
          "type": [
            "string",
            "null"
          ],
          "description": "For voltage sources: the param holding V(P) − V(N) at DC (used by ERC007)."
        },
        "spice": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpiceDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "type": "string",
          "description": "Schematic symbol, `symbols/<id>.svg`; its pin anchors are matched by pin name."
        },
        "breadboard": {
          "type": [
            "string",
            "null"
          ]
        },
        "teach": {
          "type": [
            "string",
            "null"
          ]
        },
        "hazard": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hazard"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "pins",
        "symbol"
      ]
    },
    "Category": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "R",
            "C",
            "L",
            "D",
            "Q",
            "U",
            "V",
            "J"
          ]
        },
        {
          "type": "string",
          "const": "X",
          "description": "A component from the project library (a sub-circuit): its behaviour comes from its pins'\nsemantics, not from a category rule, and it compiles to an `X` line."
        }
      ]
    },
    "PinDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "num": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "type": {
          "$ref": "#/$defs/PinType"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dc_group": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "For a library component: the pins joined by a DC path inside it share a group, and group 0\nis a DC path to ground (ERC003 on the outside, LLD §17 D6). Computed by `apply()` from the\ncomponent's own netlist, never taken from a client; unused on registry parts, whose\ncategory says which pins conduct."
        }
      },
      "required": [
        "name",
        "num",
        "type"
      ]
    },
    "PinType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "input",
            "output",
            "passive",
            "power_pos",
            "power_neg"
          ]
        },
        {
          "type": "string",
          "const": "nc",
          "description": "Not connected internally; exempt from ERC001."
        }
      ]
    },
    "ParamDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "default": {
          "type": "string"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "In SI units. YAML sources may write a prefixed number such as `1p` or `100meg`."
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "unit",
        "default"
      ]
    },
    "Unit": {
      "type": "string",
      "enum": [
        "ohm",
        "farad",
        "henry",
        "volt",
        "ampere",
        "hertz",
        "second",
        "watt",
        "unitless"
      ]
    },
    "SpiceDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_line": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "SPICE emission template. `line` is for single-unit parts; `unit_line` is emitted once per\nused unit of a multi-unit part. Placeholders: `{refdes}`, `{unit}`, pin names, param names.\nIn `unit_line`, a unit pin is named without its `_<unit>` suffix (`{OUT}` → `OUT_A`)."
    },
    "Hazard": {
      "type": "string",
      "enum": [
        "mains"
      ]
    },
    "Model": {
      "oneOf": [
        {
          "$ref": "#/$defs/Composite",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composite"
            }
          },
          "required": [
            "kind"
          ]
        }
      ],
      "description": "What the component does inside. Behavioral laws and SPICE imports join in P5.2 (LLD §17 D3)."
    },
    "CompositePart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Values as written (\"10k\"); a missing param takes the part's default.",
          "default": {}
        }
      },
      "required": [
        "part"
      ]
    },
    "Composite": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CompositePart"
          },
          "description": "Local refdes (`R1`, `U1`, scoped to the definition) -> part."
        },
        "nets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PinRef"
            }
          },
          "description": "Net -> pins. A net named after one of the component's pins is that pin; `GND` is the\ncircuit's ground; every other net is internal."
        }
      },
      "required": [
        "parts",
        "nets"
      ],
      "description": "A sub-circuit of registry parts and other library components."
    },
    "Provenance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "llm"
            }
          },
          "required": [
            "kind",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "licence": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "import"
            }
          },
          "required": [
            "kind",
            "source",
            "licence"
          ]
        }
      ],
      "description": "Who made a definition (LLD §17 D10: trust levels read it)."
    },
    "LibUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "def": {
          "$ref": "#/$defs/ComponentDef"
        }
      },
      "required": [
        "id",
        "def"
      ]
    },
    "LibRemove": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "InstanceExpand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refdes": {
          "type": "string"
        },
        "block": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of the block the parts form; default the lowest free `bN`."
        }
      },
      "required": [
        "refdes"
      ]
    },
    "BlockSetSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "spec": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecTarget"
          }
        }
      },
      "required": [
        "id",
        "spec"
      ]
    },
    "TestSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestPlan"
          }
        }
      },
      "required": [
        "tests"
      ]
    },
    "TestPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "`freq_compare`: lowercase [a-z0-9_]."
        },
        "title": {
          "type": "string"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scenario"
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Probe"
          }
        }
      },
      "required": [
        "id",
        "title",
        "scenarios",
        "probes"
      ]
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "set": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Param overrides as `REFDES.param` -> value as typed (`\"V2.frequency\": \"1k\"`), applied to a\nscratch copy, so each scenario has its own netlist and cache entry.",
          "default": {}
        },
        "analyses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Analysis"
          },
          "description": "The analyses this scenario runs; absent, the circuit's own."
        }
      },
      "required": [
        "name"
      ]
    },
    "Probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "net": {
          "type": "string"
        },
        "measure": {
          "$ref": "#/$defs/Measure"
        }
      },
      "required": [
        "name",
        "net",
        "measure"
      ]
    },
    "Measure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "amplitude"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Half the peak-to-peak over the transient's second half."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dc"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Average over the transient's second half (the DC level, bias included)."
        },
        {
          "type": "object",
          "properties": {
            "in": {
              "type": "string"
            },
            "at_hz": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "ac_gain"
            }
          },
          "required": [
            "kind",
            "in",
            "at_hz"
          ],
          "description": "|V(net)| / |V(input)| in the AC sweep at `at_hz`."
        }
      ],
      "description": "What a probe reads from its net in each scenario."
    },
    "ReqSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        }
      },
      "required": [
        "requirements"
      ]
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "`R1`, `R2`, ... as the brief numbers them."
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RequirementKind"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "description": "What will prove it; met, missing or unverifiable is decided from these after simulation.",
          "default": []
        }
      },
      "required": [
        "id",
        "text",
        "kind"
      ]
    },
    "RequirementKind": {
      "type": "string",
      "enum": [
        "functional",
        "electrical",
        "constraint",
        "deliverable",
        "test"
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "block": {
              "type": "string"
            },
            "check": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "check"
            }
          },
          "required": [
            "kind",
            "block",
            "check"
          ],
          "description": "A block's spec check (`b2.fc_hz`)."
        },
        {
          "type": "object",
          "properties": {
            "test": {
              "type": "string"
            },
            "scenario": {
              "type": "string"
            },
            "probe": {
              "type": "string"
            },
            "target": {
              "type": "number",
              "format": "double"
            },
            "tol_pct": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "probe"
            }
          },
          "required": [
            "kind",
            "test",
            "scenario",
            "probe",
            "target",
            "tol_pct"
          ],
          "description": "A probe of a test plan in one scenario, against a target."
        },
        {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "structural"
            }
          },
          "required": [
            "kind",
            "claim"
          ],
          "description": "A fact about the circuit itself (\"every op-amp is an LM358\"), checked by the core's\nstructure queries when they exist; until then it is unverifiable, never met."
        }
      ]
    },
    "OpError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "op_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "description": "Index of the failing op within a batch (`apply_all`)."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "part_not_in_registry",
            "pin_not_found",
            "pin_already_connected",
            "param_out_of_range",
            "refdes_conflict",
            "block_not_open",
            "stale_rev",
            "unknown_op",
            "limit_exceeded",
            "part_not_found",
            "param_unknown",
            "net_not_found",
            "block_not_found",
            "block_conflict",
            "hint_not_found"
          ]
        },
        {
          "type": "string",
          "const": "schema_error",
          "description": "Envelope or body does not match the schema."
        },
        {
          "type": "string",
          "const": "unsupported_version",
          "description": "Envelope `v` is not the current or previous protocol version."
        },
        {
          "type": "string",
          "const": "registry_mismatch",
          "description": "Circuit and registry versions differ."
        },
        {
          "type": "string",
          "const": "refdes_invalid",
          "description": "Refdes is malformed or its prefix does not match the part category."
        },
        {
          "type": "string",
          "const": "bad_value",
          "description": "A value string could not be parsed in the param's unit."
        },
        {
          "type": "string",
          "const": "category_mismatch",
          "description": "Swap target is in a different category."
        },
        {
          "type": "string",
          "const": "net_invalid",
          "description": "Malformed net id, ground misuse, or a kind/label that disagrees with the existing net."
        },
        {
          "type": "string",
          "const": "net_conflict",
          "description": "Net id already exists (case-insensitive, since SPICE node names are)."
        },
        {
          "type": "string",
          "const": "block_not_empty",
          "description": "Block still has parts or hints referring to it."
        },
        {
          "type": "string",
          "const": "analysis_invalid",
          "description": "Analysis parameters are invalid."
        },
        {
          "type": "string",
          "const": "forbidden",
          "description": "The author is not allowed to emit this op (e.g. `part.pin` is user-only)."
        },
        {
          "type": "string",
          "const": "template_not_found",
          "description": "No block template with this id in the registry."
        },
        {
          "type": "string",
          "const": "target_out_of_range",
          "description": "A template target or rail voltage is malformed or outside the template's range."
        },
        {
          "type": "string",
          "const": "port_invalid",
          "description": "A port binding names a net that cannot carry that port (wrong kind, missing, ground misuse)."
        },
        {
          "type": "string",
          "const": "compile_failed",
          "description": "The compiler refused a circuit that `apply()` accepted (a generated block's bench)."
        },
        {
          "type": "string",
          "const": "component_invalid",
          "description": "A library component definition is malformed (every problem listed in the message)."
        },
        {
          "type": "string",
          "const": "component_not_found",
          "description": "No library component with this id in the circuit."
        },
        {
          "type": "string",
          "const": "component_in_use",
          "description": "The library component is still used by a part or by another component."
        },
        {
          "type": "string",
          "const": "test_invalid",
          "description": "A test plan or a requirement is malformed, or names something the circuit lacks."
        }
      ],
      "description": "Error codes returned by `apply()`. These go back to the LLM verbatim during repair and are\nshown to users as friendly text (LLD §4). Additive only within a protocol major version."
    }
  }
}
