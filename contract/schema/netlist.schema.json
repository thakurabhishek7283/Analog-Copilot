{
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "Deterministic: parts in natural refdes order."
    },
    "hash": {
      "type": "string",
      "description": "Lowercase hex sha256 of `text`."
    },
    "node_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "IR net id -> SPICE node name (\"N_VOUT\" -> \"n_vout\", \"GND\" -> \"0\")."
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Registry model files the simulator must load, relative to the registry root."
    },
    "meas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MeasDef"
      },
      "description": "Spec checks as primitive `.meas` statements, in replay order (later cards may use earlier\nresults)."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpecCheckDef"
      },
      "description": "The spec checks of every template block, and which `meas` results each combines\n([`crate::template::evaluate_checks`])."
    },
    "pin_currents": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/CurrentTerm"
        }
      },
      "description": "Current into each connected pin (`\"R1.1\"`), as a sum of saved vectors, for the overlays\nand current probes. OP and transient plots only: device currents do not exist in AC.\nPins inside subcircuit models (op-amps, regulators) are absent; a net with one such pin\ngets its current by KCL."
    },
    "analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Analysis"
      },
      "description": "The analyses in the deck, in order (resolved from `CompileOpts`)."
    },
    "leaf_devices": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "description": "Primitive devices the deck simulates, library components flattened (LLD §17 D12: the\neditor runs live below a budget and asks for a Run above it).",
      "default": 0
    },
    "envelope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnvelopeDef"
      },
      "description": "The `require` laws of behavioral components, measured over the transient\n([`evaluate_envelope`])."
    }
  },
  "required": [
    "text",
    "hash",
    "node_map",
    "includes",
    "meas",
    "checks",
    "pin_currents",
    "analyses"
  ],
  "title": "Netlist",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MeasDef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "line": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "line"
      ]
    },
    "SpecCheckDef": {
      "type": "object",
      "properties": {
        "block": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CheckKind"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "target": {
          "type": "number",
          "format": "double"
        },
        "tol_pct": {
          "type": "number",
          "format": "double"
        },
        "meas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`.meas` result names, in the order the kind combines them. Empty when `missing` is set."
        },
        "edge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Edge"
            },
            {
              "type": "null"
            }
          ],
          "description": "The output edge a `tran_threshold` check measures."
        },
        "compare": {
          "$ref": "#/$defs/Compare",
          "description": "How the measurement passes (within the tolerance unless stated)."
        },
        "missing": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the check could not be compiled into this netlist (\"needs an AC analysis\")."
        }
      },
      "required": [
        "block",
        "name",
        "label",
        "symbol",
        "kind",
        "unit",
        "target",
        "tol_pct",
        "meas"
      ],
      "description": "A check as compiled into one netlist: which `.meas` results it combines."
    },
    "CheckKind": {
      "oneOf": [
        {
          "type": "string",
          "const": "ac_corner",
          "description": "−3 dB frequency below the pass-band gain (AC)."
        },
        {
          "type": "string",
          "const": "ac_q",
          "description": "Q of a 2nd-order low/high-pass: |H(f0)| / pass-band gain, f0 at the ∓90° phase point (AC).\nAssumes the input port is driven with flat phase (a source or a buffer)."
        },
        {
          "type": "string",
          "const": "ac_gain",
          "description": "|V(out)| / |V(in)| at `at_hz` (AC)."
        },
        {
          "type": "string",
          "const": "ac_center",
          "description": "Band-pass centre, √(f_lo·f_hi) of the −3 dB points around the peak (AC)."
        },
        {
          "type": "string",
          "const": "ac_band_q",
          "description": "Band-pass Q, centre / (f_hi − f_lo) (AC)."
        },
        {
          "type": "string",
          "const": "tran_freq",
          "description": "Frequency of a periodic output: two periods between rising crossings of mid-level, in the\nsecond half of the transient (tran)."
        },
        {
          "type": "string",
          "const": "tran_duty",
          "description": "Share of a period the output is high, from its average over two periods (tran)."
        },
        {
          "type": "string",
          "const": "tran_amplitude",
          "description": "Half the peak-to-peak output (tran)."
        },
        {
          "type": "string",
          "const": "dc_level",
          "description": "Average output over the transient: the DC level (ngspice `.meas` has no OP mode)."
        },
        {
          "type": "string",
          "const": "tran_threshold",
          "description": "Input level at the 2nd rising/falling output edge: a comparator threshold (tran)."
        },
        {
          "type": "string",
          "const": "tran_headroom",
          "description": "How far the output stays inside its supply over the second half of the run: the smaller of\nV(supply+) - max V(out) and min V(out) - V(supply-) (ground without a second supply\nport). Passes at least the target by default: \"avoid clipping\", measured (LLD §17 D7)."
        },
        {
          "type": "string",
          "const": "ac_db_at",
          "description": "Gain in dB at `at_hz` (default 1 kHz): 20·log10 |V(out)/V(in)|, or |V(out)| re 1 V\nwithout `in` (AC)."
        },
        {
          "type": "string",
          "const": "tran_rms",
          "description": "RMS of the output around its average over the second half of the run (tran): a signal\nlevel that ignores the bias of a single-supply stage."
        },
        {
          "type": "string",
          "const": "dc_transfer",
          "description": "Output level at the input level `at_v`, from a DC sweep of the source driving `in`."
        },
        {
          "type": "string",
          "const": "tran_rise",
          "description": "10-90% rise time of the output's first rising edge in the second half of the run, levels\nfrom its own minimum and maximum there (tran)."
        }
      ],
      "description": "LLD §7 spec checks. Each is a few primitive ngspice `.meas` results combined by\n[`evaluate_checks`] (ngspice cannot measure an expression such as `vdb(out)-vdb(in)`)."
    },
    "Unit": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ohm",
            "farad",
            "henry",
            "volt",
            "ampere",
            "hertz",
            "second",
            "watt",
            "unitless"
          ]
        },
        {
          "type": "string",
          "const": "decibel",
          "description": "A ratio in decibels (`ac_db_at` checks)."
        }
      ]
    },
    "Edge": {
      "type": "string",
      "enum": [
        "rise",
        "fall"
      ]
    },
    "Compare": {
      "oneOf": [
        {
          "type": "string",
          "const": "within",
          "description": "Within ±tol of the target."
        },
        {
          "type": "string",
          "const": "at_least",
          "description": "At least the target, less tol."
        },
        {
          "type": "string",
          "const": "at_most",
          "description": "At most the target, plus tol."
        }
      ],
      "description": "How a measurement passes against its target and tolerance."
    },
    "CurrentTerm": {
      "type": "object",
      "properties": {
        "vector": {
          "type": "string",
          "description": "Canonical result vector name: `@r1[i]`, `i(v1)`, `@q1[ic]`."
        },
        "coeff": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "vector",
        "coeff"
      ],
      "description": "`coeff · vector`, e.g. `-1 · @r1[i]`."
    },
    "Analysis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "op"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "start": {
              "type": "number",
              "format": "double"
            },
            "stop": {
              "type": "number",
              "format": "double"
            },
            "step": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "dc"
            }
          },
          "required": [
            "type",
            "source",
            "start",
            "stop",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "points_per_decade": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "f_start": {
              "type": "number",
              "format": "double"
            },
            "f_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ac"
            }
          },
          "required": [
            "type",
            "points_per_decade",
            "f_start",
            "f_stop"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t_step": {
              "type": "number",
              "format": "double"
            },
            "t_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "tran"
            }
          },
          "required": [
            "type",
            "t_step",
            "t_stop"
          ]
        }
      ]
    },
    "EnvelopeDef": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string",
          "description": "The instance."
        },
        "law": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "description": "The law's number in its definition (1-based)."
        },
        "text": {
          "type": "string",
          "description": "The law as written."
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "lo": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hi": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "meas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`.meas` names of the largest and smallest value; empty when `missing` is set."
        },
        "missing": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "part",
        "law",
        "text",
        "unit",
        "meas"
      ],
      "description": "A behavioral component's `require` as compiled into one netlist (LLD §17 D3, the envelope)."
    }
  }
}
