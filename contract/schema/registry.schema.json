{
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PartDef"
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SymbolDef"
      },
      "description": "Schematic symbols by id (`symbols/<id>.svg`): geometry only; the drawings ship in the\nbundle's sprite sheet."
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TemplateDef"
      },
      "description": "Block templates by id (`templates/<id>.yaml`), each checked against the parts at load.",
      "default": {}
    }
  },
  "required": [
    "version",
    "parts",
    "symbols"
  ],
  "title": "Registry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PartDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ],
          "description": "Refdes prefix when it is not the category letter (`RV`, `TP`); see [`EXTRA_PREFIXES`]."
        },
        "title": {
          "type": "string"
        },
        "role_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Units of a multi-unit IC (e.g. `[A, B]` for a dual op-amp). Empty for single-unit parts.",
          "default": []
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinDef"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParamDef"
          },
          "description": "Every param must declare a default, so instances always carry a full param set.",
          "default": {}
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "description": "Ratings used by ERC, e.g. `v_supply_max`, `i_max`, `p_max`.",
          "default": {}
        },
        "dc_param": {
          "type": [
            "string",
            "null"
          ],
          "description": "For voltage sources: the param holding V(P) − V(N) at DC (used by ERC007)."
        },
        "spice": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpiceDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "type": "string",
          "description": "Schematic symbol, `symbols/<id>.svg`; its pin anchors are matched by pin name."
        },
        "breadboard": {
          "type": [
            "string",
            "null"
          ]
        },
        "teach": {
          "type": [
            "string",
            "null"
          ]
        },
        "hazard": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hazard"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "pins",
        "symbol"
      ]
    },
    "Category": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "R",
            "C",
            "L",
            "D",
            "Q",
            "U",
            "V",
            "J"
          ]
        },
        {
          "type": "string",
          "const": "X",
          "description": "A component from the project library (a sub-circuit): its behaviour comes from its pins'\nsemantics, not from a category rule, and it compiles to an `X` line."
        }
      ]
    },
    "PinDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "num": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "type": {
          "$ref": "#/$defs/PinType"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dc_group": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "For a library component: the pins joined by a DC path inside it share a group, and group 0\nis a DC path to ground (ERC003 on the outside, LLD §17 D6). Computed by `apply()` from the\ncomponent's own netlist, never taken from a client; unused on registry parts, whose\ncategory says which pins conduct."
        }
      },
      "required": [
        "name",
        "num",
        "type"
      ]
    },
    "PinType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "input",
            "output",
            "passive",
            "power_pos",
            "power_neg"
          ]
        },
        {
          "type": "string",
          "const": "nc",
          "description": "Not connected internally; exempt from ERC001."
        }
      ]
    },
    "ParamDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "default": {
          "type": "string"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "In SI units. YAML sources may write a prefixed number such as `1p` or `100meg`."
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "unit",
        "default"
      ]
    },
    "Unit": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ohm",
            "farad",
            "henry",
            "volt",
            "ampere",
            "hertz",
            "second",
            "watt",
            "unitless"
          ]
        },
        {
          "type": "string",
          "const": "decibel",
          "description": "A ratio in decibels (`ac_db_at` checks)."
        }
      ]
    },
    "SpiceDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_line": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "SPICE emission template. `line` is for single-unit parts; `unit_line` is emitted once per\nused unit of a multi-unit part. Placeholders: `{refdes}`, `{unit}`, pin names, param names.\nIn `unit_line`, a unit pin is named without its `_<unit>` suffix (`{OUT}` → `OUT_A`)."
    },
    "Hazard": {
      "type": "string",
      "enum": [
        "mains"
      ]
    },
    "SymbolDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Size in schematic units (multiples of [`GRID`])."
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Anchor"
          },
          "description": "Pin anchors by pin name (base name for the unit pins of a multi-unit part)."
        }
      },
      "required": [
        "width",
        "height",
        "pins"
      ]
    },
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "side": {
          "$ref": "#/$defs/Side",
          "description": "The edge the anchor sits on; wires leave the symbol in this direction."
        }
      },
      "required": [
        "x",
        "y",
        "side"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ]
    },
    "TemplateDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/BlockRole"
        },
        "title": {
          "type": "string"
        },
        "teach": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TargetDef"
          },
          "description": "What the user asks for, in order (the insert form shows them in this order).",
          "default": {}
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PortDirection"
          },
          "description": "The block's interface: port name -> direction."
        },
        "rails": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RailDef"
          },
          "description": "The supply each power port expects: default rail and the range the design works over.",
          "default": {}
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TemplatePart"
          },
          "description": "Local refdes (R1, C1, U1, ...) -> registry part. Renumbered on instantiation."
        },
        "nets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PinRef"
            }
          },
          "description": "Port or internal net name -> pins (`R1.2`, `U1.OUT_A`). Every port has one."
        },
        "solver": {
          "type": [
            "string",
            "null"
          ],
          "description": "A solver in [`solvers`], by name; or `rules`."
        },
        "rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRules"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value rules as data (LLD §17 D5): the targets and rails (volts, by power port) are the inputs."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckDef"
          }
        },
        "verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerifyBench"
            },
            {
              "type": "null"
            }
          ],
          "description": "The test bench CI simulates the template in (LLD §12 step 2)."
        }
      },
      "required": [
        "id",
        "version",
        "role",
        "title",
        "ports",
        "parts",
        "nets",
        "checks"
      ]
    },
    "BlockRole": {
      "type": "string",
      "enum": [
        "supply",
        "source",
        "bias",
        "amplifier",
        "buffer",
        "filter",
        "oscillator",
        "comparator",
        "load",
        "other"
      ]
    },
    "TargetDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "min": {
          "type": "number",
          "format": "double",
          "description": "In SI units; YAML may write `10`, `50k` or `1meg`."
        },
        "max": {
          "type": "number",
          "format": "double"
        },
        "default": {
          "type": "string",
          "description": "As the user would type it."
        },
        "scale": {
          "$ref": "#/$defs/Scale",
          "description": "How verification spreads its points (frequencies and gains are `log`).",
          "default": "lin"
        }
      },
      "required": [
        "label",
        "unit",
        "min",
        "max",
        "default"
      ]
    },
    "Scale": {
      "type": "string",
      "enum": [
        "lin",
        "log"
      ]
    },
    "PortDirection": {
      "type": "string",
      "enum": [
        "input",
        "output",
        "bidir",
        "power_pos",
        "power_neg",
        "ground"
      ]
    },
    "RailDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "net": {
          "type": "string",
          "description": "The rail this port binds to by default (created if missing)."
        },
        "volts": {
          "type": "number",
          "format": "double"
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "The supply range the design is verified over; absent means exactly `volts`."
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "net",
        "volts"
      ]
    },
    "TemplatePart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "part": {
          "type": "string"
        }
      },
      "required": [
        "part"
      ]
    },
    "PinRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$",
      "description": "Part pin as REFDES.PIN, e.g. \"R3.1\" or \"U1.OUT_A\"."
    },
    "ValueRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "funcs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "User functions, `\"name(a, b)\" -> body`; a function may call those before it."
        },
        "solve": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Steps in order. A part's local refdes (`R1`, or `R1.resistance` for a part with several\nparams) sets that part value; any other name (lowercase) is an intermediate value."
        },
        "estimates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Forward estimates, each scored against the target or step of the same name."
        },
        "prefer": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Steps to keep near a nominal value when the estimates tie."
        },
        "spec": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Spec targets derived from the inputs and the chosen values (a follower's gain of 1)."
        }
      },
      "required": [
        "solve"
      ]
    },
    "CheckDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "symbol": {
          "type": "string",
          "description": "A few characters for badges on the drawing: `fc`, `Q`, `Vth+`."
        },
        "kind": {
          "$ref": "#/$defs/CheckKind"
        },
        "out": {
          "type": "string",
          "description": "Output port measured."
        },
        "in": {
          "type": [
            "string",
            "null"
          ],
          "description": "Input port (gain reference, threshold input)."
        },
        "pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pass"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which side of a corner is the pass band (corner and Q checks)."
        },
        "edge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Edge"
            },
            {
              "type": "null"
            }
          ],
          "description": "Output edge whose input level is the threshold (threshold checks)."
        },
        "at_hz": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Frequency a gain is measured at; default 1 kHz."
        },
        "tran": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranWindow"
            },
            {
              "type": "null"
            }
          ],
          "description": "The transient a time-domain check needs. Regenerative circuits (a Schmitt trigger) switch\nlate in simulation unless the steps are near the op-amp's own speed: with coarse steps the\nintegrator follows the unstable balance point until it hits a rail."
        },
        "tol_pct": {
          "type": "number",
          "format": "double"
        },
        "supply": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Supply ports a headroom check measures against: the positive one, then optionally the\nnegative one (ground without it)."
        },
        "at_v": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "description": "Input level a `dc_transfer` check reads the output at, volts."
        },
        "compare": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the measurement passes; each kind has a default (headroom: at least the target)."
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "A component contract's target, as an expression of the component's params (`gain`,\n`1/(2*pi*r*c)`). Template checks take theirs from the block's spec instead."
        }
      },
      "required": [
        "name",
        "label",
        "symbol",
        "kind",
        "out",
        "tol_pct"
      ],
      "description": "One spec check: what to measure (a closed set of kinds, so a template can never inject SPICE)\non which ports. Its target is the block's `spec[name]`."
    },
    "CheckKind": {
      "oneOf": [
        {
          "type": "string",
          "const": "ac_corner",
          "description": "−3 dB frequency below the pass-band gain (AC)."
        },
        {
          "type": "string",
          "const": "ac_q",
          "description": "Q of a 2nd-order low/high-pass: |H(f0)| / pass-band gain, f0 at the ∓90° phase point (AC).\nAssumes the input port is driven with flat phase (a source or a buffer)."
        },
        {
          "type": "string",
          "const": "ac_gain",
          "description": "|V(out)| / |V(in)| at `at_hz` (AC)."
        },
        {
          "type": "string",
          "const": "ac_center",
          "description": "Band-pass centre, √(f_lo·f_hi) of the −3 dB points around the peak (AC)."
        },
        {
          "type": "string",
          "const": "ac_band_q",
          "description": "Band-pass Q, centre / (f_hi − f_lo) (AC)."
        },
        {
          "type": "string",
          "const": "tran_freq",
          "description": "Frequency of a periodic output: two periods between rising crossings of mid-level, in the\nsecond half of the transient (tran)."
        },
        {
          "type": "string",
          "const": "tran_duty",
          "description": "Share of a period the output is high, from its average over two periods (tran)."
        },
        {
          "type": "string",
          "const": "tran_amplitude",
          "description": "Half the peak-to-peak output (tran)."
        },
        {
          "type": "string",
          "const": "dc_level",
          "description": "Average output over the transient: the DC level (ngspice `.meas` has no OP mode)."
        },
        {
          "type": "string",
          "const": "tran_threshold",
          "description": "Input level at the 2nd rising/falling output edge: a comparator threshold (tran)."
        },
        {
          "type": "string",
          "const": "tran_headroom",
          "description": "How far the output stays inside its supply over the second half of the run: the smaller of\nV(supply+) - max V(out) and min V(out) - V(supply-) (ground without a second supply\nport). Passes at least the target by default: \"avoid clipping\", measured (LLD §17 D7)."
        },
        {
          "type": "string",
          "const": "ac_db_at",
          "description": "Gain in dB at `at_hz` (default 1 kHz): 20·log10 |V(out)/V(in)|, or |V(out)| re 1 V\nwithout `in` (AC)."
        },
        {
          "type": "string",
          "const": "tran_rms",
          "description": "RMS of the output around its average over the second half of the run (tran): a signal\nlevel that ignores the bias of a single-supply stage."
        },
        {
          "type": "string",
          "const": "dc_transfer",
          "description": "Output level at the input level `at_v`, from a DC sweep of the source driving `in`."
        },
        {
          "type": "string",
          "const": "tran_rise",
          "description": "10-90% rise time of the output's first rising edge in the second half of the run, levels\nfrom its own minimum and maximum there (tran)."
        }
      ],
      "description": "LLD §7 spec checks. Each is a few primitive ngspice `.meas` results combined by\n[`evaluate_checks`] (ngspice cannot measure an expression such as `vdb(out)-vdb(in)`)."
    },
    "Pass": {
      "type": "string",
      "enum": [
        "low",
        "high"
      ]
    },
    "Edge": {
      "type": "string",
      "enum": [
        "rise",
        "fall"
      ]
    },
    "TranWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop": {
          "type": "number",
          "format": "double",
          "description": "Run length, seconds."
        },
        "step": {
          "type": "number",
          "format": "double",
          "description": "Largest step, seconds."
        }
      },
      "required": [
        "stop",
        "step"
      ]
    },
    "Compare": {
      "oneOf": [
        {
          "type": "string",
          "const": "within",
          "description": "Within ±tol of the target."
        },
        {
          "type": "string",
          "const": "at_least",
          "description": "At least the target, less tol."
        },
        {
          "type": "string",
          "const": "at_most",
          "description": "At most the target, plus tol."
        }
      ],
      "description": "How a measurement passes against its target and tolerance."
    },
    "VerifyBench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drive": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Drive"
          },
          "description": "A sine source from each listed port to ground.",
          "default": {}
        },
        "load": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "description": "A resistor from each listed port to ground, in ohms.",
          "default": {}
        }
      }
    },
    "Drive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amplitude": {
          "type": "number",
          "format": "double"
        },
        "frequency": {
          "type": "number",
          "format": "double"
        },
        "offset": {
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "required": [
        "amplitude",
        "frequency"
      ]
    }
  }
}
