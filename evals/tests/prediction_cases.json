{
  "_comment": "An experiment's prediction against the spec checks re-simulated before and after it. Both readings of the rule run these cases: the tutor evals (tutor_metrics.prediction, test_tutor_metrics.py) and the editor's Try-it card (apps/web/src/tutor/predict.ts, predict.test.ts). `expect` is the result; a case without `number` or `check` leaves that field unchecked.",
  "checks": {
    "fc": {"block": "b2", "name": "fc_hz", "unit": "hertz", "tol_pct": 10.0},
    "q": {"block": "b2", "name": "q", "unit": "unitless", "tol_pct": 15.0},
    "gain": {"block": "b3", "name": "gain", "unit": "unitless", "tol_pct": 5.0},
    "vout": {"block": "b3", "name": "vout", "unit": "volt", "tol_pct": 2.0}
  },
  "cases": [
    {"why": "the check that moved, within 10%",
     "predict": "fc drops to about 500 Hz", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"number": "500 Hz", "check": "b2 fc_hz", "measured": 499.0, "held": true}},
    {"why": "more than 10% off",
     "predict": "fc drops to 300 Hz", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"held": false}},
    {"why": "Q did not move: nothing to compare",
     "predict": "Q stays near 0.7", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"held": null}},
    {"why": "the from value is not the prediction",
     "predict": "fc drops from 996 Hz to about 500 Hz; Q stays 0.706", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"held": true}},
    {"why": "no number",
     "predict": "the output gets smaller", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"number": null, "check": null, "held": null}},
    {"why": "no check in volts",
     "predict": "about 2 V", "before": {"fc": 996.0, "q": 0.706}, "after": {"fc": 499.0, "q": 0.706},
     "expect": {"number": "2 V", "check": null, "held": null}},
    {"why": "an SI prefix",
     "predict": "the cutoff rises to roughly 2.1kHz", "before": {"fc": 996.0}, "after": {"fc": 2050.0},
     "expect": {"number": "2.1kHz", "check": "b2 fc_hz", "measured": 2050.0, "held": true}},
    {"why": "LaTeX read as plain text",
     "predict": "fc \\approx 500\\,\\text{Hz}", "before": {"fc": 996.0}, "after": {"fc": 499.0},
     "expect": {"check": "b2 fc_hz", "held": true}},
    {"why": "a unitless number matches a unitless check",
     "predict": "the gain becomes about 11", "before": {"gain": 10.0}, "after": {"gain": 10.9},
     "expect": {"number": "11", "check": "b3 gain", "held": true}},
    {"why": "the wider of 10% and the check's tolerance",
     "predict": "Q rises to about 1.0", "before": {"q": 0.706}, "after": {"q": 1.17},
     "expect": {"check": "b2 q", "held": true}},
    {"why": "a sign does not matter",
     "predict": "the output settles near -3.3 V", "before": {"vout": 5.0}, "after": {"vout": 3.31},
     "expect": {"number": "-3.3 V", "check": "b3 vout", "held": true}},
    {"why": "the closest pair of several",
     "predict": "fc near 480 Hz and the gain stays at 1", "before": {"fc": 996.0, "gain": 2.0}, "after": {"fc": 499.0, "gain": 1.0},
     "expect": {"held": true}},
    {"why": "a check without a measurement after is left out",
     "predict": "fc about 500 Hz", "before": {"fc": 996.0}, "after": {"fc": null},
     "expect": {"check": null, "held": null}},
    {"why": "a bound is not a value",
     "predict": "the cutoff drops well below 2 kHz", "before": {"fc": 1940.0}, "after": {"fc": 159.0},
     "expect": {"number": null, "check": null, "held": null}},
    {"why": "a value after a bound is still compared",
     "predict": "fc falls below 1 kHz, to about 500 Hz", "before": {"fc": 996.0}, "after": {"fc": 499.0},
     "expect": {"number": "500 Hz", "held": true}},
    {"why": "a check new after the experiment counts as moved",
     "predict": "fc about 500 Hz", "before": {}, "after": {"fc": 520.0},
     "expect": {"check": "b2 fc_hz", "held": true}}
  ]
}
