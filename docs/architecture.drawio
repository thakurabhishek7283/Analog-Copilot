h=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b15" target="b16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b41" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b42" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b17" target="b13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="1345"/><mxPoint x="1040" y="1080"/></Array></mxGeometry></mxCell><mxCell id="b43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b45" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b20" target="b21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b46" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b20" target="b9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="1715"/><mxPoint x="330" y="720"/></Array></mxGeometry></mxCell><mxCell id="b47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b21" target="b22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b48" value="&lt;b&gt;Why plan in blocks?&lt;/b&gt;&lt;br&gt;Each LLM call stays small (≈5–25 parts), errors are local and repairable, and blocks map 1:1 onto the animation: one block = one “chapter” the student watches being built." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="380" height="120" as="geometry"/></mxCell><mxCell id="b49" value="&lt;b&gt;Constrained decoding&lt;/b&gt;&lt;br&gt;partId is a JSON-schema enum of retrieved candidates; pin names come from that part's pin map. The model cannot reference a pin that doesn't exist." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="790" width="380" height="110" as="geometry"/></mxCell><mxCell id="b50" value="&lt;b&gt;Latency trick&lt;/b&gt;&lt;br&gt;Narration streams immediately; geometry is committed only after a block passes. Show a ghost outline of the planned block while it is being verified." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1440" width="380" height="110" as="geometry"/></mxCell><mxCell id="b51" value="&lt;b&gt;Honesty rule&lt;/b&gt;&lt;br&gt;Never animate an unverified circuit as if it works. Failed repair → verified template + a clear note." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1170" width="380" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c" name="3 · Click-to-Ask &amp; User-Edit Loops"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Interaction Loops — grounded tutoring &amp;amp; local-first editing" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c2" value="CLICK-TO-ASK (grounded tutoring)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf8f2;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="460" height="960" as="geometry"/></mxCell><mxCell id="c3" value="USER EDIT LOOP (local, no LLM in the hot path)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="600" height="960" as="geometry"/></mxCell><mxCell id="c4" value="User selects R3 / a net / a block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Context Builder&lt;/b&gt; (client)&lt;br&gt;part + 1-hop subgraph + block role&lt;br&gt;+ live node V / branch I + learner level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="380" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Question typed — or suggested chips:&lt;br&gt;“Why this value?” “What if I double it?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="380" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Tutor Service&lt;/b&gt;&lt;br&gt;cached system prompt + ~1–2k token context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="380" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Small/fast LLM&lt;/b&gt; streams answer&lt;br&gt;with refs: [R3] [net:VOUT] [block:b2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="380" height="70" as="geometry"/></mxCell><mxCell id="c9" value="UI highlights referenced parts, probes nets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="380" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Answer proposes&lt;br&gt;a change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="700" width="240" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Render as &lt;b&gt;“Try it”&lt;/b&gt; op card&lt;br&gt;user confirms → becomes a normal op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="380" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="no — ask more" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="750"/><mxPoint x="40" y="140"/></Array></mxGeometry></mxCell><mxCell id="c20" value="User action: place · move · rewire&lt;br&gt;change value · swap part · delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="340" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Emit op — &lt;b&gt;same schema as LLM ops&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="340" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Local validate: ⚙ circuit-core WASM (&amp;lt; 1 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="340" height="60" as="geometry"/></mxCell><mxCell id="c23" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="380" width="240" height="100" as="geometry"/></mxCell><mxCell id="c24" value="Inline warning&lt;br&gt;+ optional tutor hint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="395" width="200" height="70" as="geometry"/></mxCell><mxCell id="c25" value="Append to Op Log&lt;br&gt;(undo/redo · autosave · CRDT-ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="340" height="60" as="geometry"/></mxCell><mxCell id="c26" value="Incremental layout (affected parts only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="610" width="340" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Recompile IR → SPICE → re-sim in Worker&lt;br&gt;(debounced ~150 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="340" height="70" as="geometry"/></mxCell><mxCell id="c28" value="Update overlays: current flow ·&lt;br&gt;node voltages · scope traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="340" height="60" as="geometry"/></mxCell><mxCell id="c29" value="Optional: &lt;b&gt;“What changed &amp;amp; why?”&lt;/b&gt;&lt;br&gt;tutor explains sim diff (before vs after)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="890" width="340" height="70" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="user fixes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c24" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="875"/><mxPoint x="500" y="230"/></Array></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Context budget&lt;/b&gt;&lt;br&gt;Never send the whole circuit for a local question. Selected part + neighbours + block role + 3–6 live values is enough and keeps answers grounded in real numbers, not vibes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1160" y="200" width="400" height="130" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;One schema, two authors&lt;/b&gt;&lt;br&gt;LLM ops and user ops are identical → one validator, one undo stack, one animation system, perfect replay of any lesson." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="400" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>