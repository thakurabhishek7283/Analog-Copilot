<mxfile host="app.diagrams.net" type="device"><diagram id="a" name="1 · High-Level Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="AI Circuit Tutor — High-Level Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="a2" value="BROWSER (TypeScript · React) — local-first: layout, animation &amp;amp; simulation all run here" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1020" height="820" as="geometry"/></mxCell><mxCell id="a3" value="BACKEND (Python 3.12 · FastAPI · asyncio) — LLM orchestration, validation, persistence" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf8f2;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="800" height="820" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;UI Shell&lt;/b&gt; — React + TypeScript · Tailwind · Zustand · Vite  (types generated from the contract)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="960" height="50" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Schematic View&lt;/b&gt;&lt;br&gt;SVG · pan/zoom · selection&lt;br&gt;&lt;i&gt;primary learning view&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="210" height="80" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Breadboard View&lt;/b&gt;&lt;br&gt;PixiJS (WebGL) sprites&lt;br&gt;&lt;i&gt;derived — never LLM-placed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="210" height="80" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Edit Tools&lt;/b&gt;&lt;br&gt;place · wire · move · value&lt;br&gt;swap · delete → emit ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="200" width="210" height="80" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Inspector + Prompt/Ask&lt;/b&gt;&lt;br&gt;selection → context builder&lt;br&gt;reads live sim values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="210" height="80" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;Layout Worker&lt;/b&gt;&lt;br&gt;ELK.js (schematic) +&lt;br&gt;breadboard placer/router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="210" height="80" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;Animation Director&lt;/b&gt;&lt;br&gt;op queue → GSAP timeline&lt;br&gt;pace · pause · replay · scrub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="210" height="80" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;Local Validator&lt;/b&gt; ⚙ circuit-core&lt;br&gt;(Rust → WASM)&lt;br&gt;same code as server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="350" width="210" height="80" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;Stream Client&lt;/b&gt;&lt;br&gt;fetch + SSE · NDJSON parser&lt;br&gt;1 line = 1 complete op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="350" width="210" height="80" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Component Registry&lt;/b&gt; (CDN)&lt;br&gt;symbols · pin maps · BB sprites&lt;br&gt;SPICE models · &lt;i&gt;ALL geometry&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="210" height="90" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;CIRCUIT STORE — single source of truth&lt;/b&gt;&lt;br&gt;Circuit IR (parts · pins · nets · blocks) + append-only Op Log&lt;br&gt;Zustand + Immer · undo/redo · Yjs later for multiplayer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="460" height="90" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;IndexedDB&lt;/b&gt;&lt;br&gt;offline projects&lt;br&gt;cached sim results" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="210" height="90" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;IR → SPICE Compiler&lt;/b&gt; ⚙ circuit-core&lt;br&gt;(Rust → WASM) · deterministic&lt;br&gt;identical netlist to server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="210" height="80" as="geometry"/></mxCell><mxCell id="a17" value="&lt;b&gt;Sim Worker&lt;/b&gt;&lt;br&gt;ngspice → WASM (Emscripten)&lt;br&gt;Comlink · Float64Array transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="660" width="210" height="80" as="geometry"/></mxCell><mxCell id="a18" value="&lt;b&gt;Scope + Overlays&lt;/b&gt;&lt;br&gt;uPlot waveforms · current flow&lt;br&gt;&amp;amp; voltage heat on both views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="660" width="210" height="80" as="geometry"/></mxCell><mxCell id="a19" value="Interactive simulation runs entirely in the browser → zero server cost per tweak, works offline, scales with users for free. Server-side LLM cost is the only thing you pay to scale." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="960" height="60" as="geometry"/></mxCell><mxCell id="a20" value="&lt;b&gt;API Gateway&lt;/b&gt; — FastAPI + Uvicorn · auth · rate limits · SSE (sse-starlette) · Pydantic v2 models generated from the shared contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="750" height="50" as="geometry"/></mxCell><mxCell id="a21" value="&lt;b&gt;Generation Orchestrator&lt;/b&gt; (async Python)&lt;br&gt;① Planner → block plan + target specs&lt;br&gt;② Composer → ops per block (enum-constrained partIds)&lt;br&gt;③ Validate → ④ Repair (≤3 tries) → ⑤ Commit &amp;amp; stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="200" width="480" height="110" as="geometry"/></mxCell><mxCell id="a22" value="&lt;b&gt;Tutor Service&lt;/b&gt;&lt;br&gt;grounded prompts:&lt;br&gt;subgraph + sim values&lt;br&gt;+ learner level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="200" width="210" height="110" as="geometry"/></mxCell><mxCell id="a23" value="&lt;b&gt;Validator&lt;/b&gt; ⚙ circuit-core&lt;br&gt;(Rust via PyO3)&lt;br&gt;schema + ERC · releases GIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="360" width="210" height="80" as="geometry"/></mxCell><mxCell id="a24" value="&lt;b&gt;Sim Worker Pool&lt;/b&gt;&lt;br&gt;ngspice subprocess per job&lt;br&gt;timeout + mem cap · arq/Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="360" width="210" height="80" as="geometry"/></mxCell><mxCell id="a25" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;model routing · structured output&lt;br&gt;prompt caching · cost metering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="360" width="210" height="80" as="geometry"/></mxCell><mxCell id="a26" value="&lt;b&gt;Retrieval&lt;/b&gt;&lt;br&gt;Parts catalog + &lt;b&gt;verified block templates&lt;/b&gt; (curated, sim-tested)&lt;br&gt;Postgres + pgvector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="480" height="80" as="geometry"/></mxCell><mxCell id="a27" value="&lt;b&gt;LLM Providers&lt;/b&gt; (external)&lt;br&gt;large model: plan / compose&lt;br&gt;small model: tutor / routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1650" y="500" width="210" height="80" as="geometry"/></mxCell><mxCell id="a28" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;users · projects · op logs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="210" height="80" as="geometry"/></mxCell><mxCell id="a29" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;arq job queue · rate limit · cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="650" width="210" height="80" as="geometry"/></mxCell><mxCell id="a30" value="&lt;b&gt;Object Storage&lt;/b&gt; (S3/R2)&lt;br&gt;exports · sim artifacts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1650" y="650" width="210" height="80" as="geometry"/></mxCell><mxCell id="a31" value="&lt;b&gt;Eval Harness&lt;/b&gt; (pytest, in CI)&lt;br&gt;~200 prompts → generate → simulate → pass/fail vs spec&lt;br&gt;gates every prompt / model change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="780" width="480" height="80" as="geometry"/></mxCell><mxCell id="a32" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;OpenTelemetry + LLM traces&lt;br&gt;(e.g. Langfuse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1650" y="780" width="210" height="80" as="geometry"/></mxCell><mxCell id="a33" value="&lt;b&gt;GOLDEN RULE:&lt;/b&gt; the LLM emits &lt;b&gt;semantics only&lt;/b&gt; — partIds from the registry, pin names, nets, block grouping, target specs and prose. It &lt;b&gt;never&lt;/b&gt; emits coordinates, wire paths or breadboard holes. Geometry = Component Registry + deterministic Layout Engine. Every op is validated before it touches the store, whether it came from the LLM or the user." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1860" height="80" as="geometry"/></mxCell><mxCell id="a34" value="&lt;b&gt;⚙ SHARED: circuit-core&lt;/b&gt; (Rust crate) — Circuit IR types · op schema · ERC rules · IR→SPICE compiler.  Builds to &lt;b&gt;WASM&lt;/b&gt; (wasm-pack → browser) and a &lt;b&gt;Python wheel&lt;/b&gt; (PyO3 + maturin → backend). JSON Schema exported via schemars → codegen &lt;b&gt;TS types&lt;/b&gt; (json-schema-to-typescript) + &lt;b&gt;Pydantic&lt;/b&gt; models (datamodel-code-generator). One implementation, two runtimes: a circuit the server validated simulates bit-identically in the browser." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;strokeWidth=3;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1860" height="90" as="geometry"/></mxCell><mxCell id="a35" value="user op" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a7" target="a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a36" value="valid op" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.772;entryY=0;" edge="1" parent="1" source="a11" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a37" value="LLM ops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="a12" target="a10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="470"/><mxPoint x="447" y="470"/></Array></mxGeometry></mxCell><mxCell id="a38" value="apply (timed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.137;entryY=0;" edge="1" parent="1" source="a10" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a39" value="IR diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2;entryX=0.75;entryY=1;" edge="1" parent="1" source="a14" target="a9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="518"/><mxPoint x="280" y="460"/><mxPoint x="207" y="460"/></Array></mxGeometry></mxCell><mxCell id="a40" value="geometry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="a13" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.4;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="a9" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;e