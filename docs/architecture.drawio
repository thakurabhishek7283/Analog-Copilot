;" vertex="1" parent="1"><mxGeometry x="800" y="1030" width="200" height="100" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Repair prompt&lt;/b&gt;&lt;br&gt;exact errors + offending ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="240" height="70" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Fallback&lt;/b&gt;: nearest verified template&lt;br&gt;+ honest note to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="1170" width="240" height="80" as="geometry"/></mxCell><mxCell id="b16" value="Compile (⚙ circuit-core) → SPICE&lt;br&gt;&lt;b&gt;ngspice worker pool&lt;/b&gt;: OP · AC · short tran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="1170" width="320" height="80" as="geometry"/></mxCell><mxCell id="b17" value="Meets target spec?&lt;br&gt;(gain · f&lt;sub&gt;c&lt;/sub&gt; · bias ± tol)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1290" width="240" height="110" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;COMMIT&lt;/b&gt; → stream block ops to client&lt;br&gt;(SSE, NDJSON, block.begin … block.commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="1440" width="320" height="70" as="geometry"/></mxCell><mxCell id="b19" value="&lt;b&gt;Client&lt;/b&gt;: incremental layout (ELK + placer)&lt;br&gt;→ animate block build → narrate block&lt;br&gt;→ re-sim whole circuit in WASM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry 